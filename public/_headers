# Cloudflare response headers.
# Only the Bogman site may read the data files from a browser. (Determined people can still download them.)
/pygmy-data.json
  Access-Control-Allow-Origin: https://www.burymeinthebog.com
  Cache-Control: public, max-age=3600
  X-Robots-Tag: noindex

/flowers.csv
  Access-Control-Allow-Origin: https://www.burymeinthebog.com
  Cache-Control: public, max-age=600
  X-Robots-Tag: noindex

/map/*
  Cache-Control: public, max-age=604800

/widget.js
  Cache-Control: public, max-age=3600

/*
  X-Robots-Tag: noindex
